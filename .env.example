# Variables de entorno de la aplicación (configúralas en Vercel → Project → Settings → Environment Variables)

# Proveedor de IA: "gemini" (por defecto) o "anthropic"
IA_PROVIDER=gemini

# Clave de Google Gemini (capa gratuita). Obtén una en https://aistudio.google.com
GEMINI_API_KEY=AIza...
# Modelo de Gemini (opcional). Por defecto gemini-2.5-flash
GEMINI_MODEL=gemini-2.5-flash

# Si usas Anthropic en lugar de Gemini:
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Contraseña compartida para entrar a la app (piloto)
APP_PASSWORD=cambia-esta-contrasena

# Secreto para firmar la cookie de sesión (usa una cadena larga y aleatoria)
AUTH_SECRET=genera-una-cadena-larga-aleatoria

# Postgres — lo agrega automáticamente la integración de Vercel Postgres / Neon.
# POSTGRES_URL=...
